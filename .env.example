# ================================================
# REPURPOSE — Environment Variables
# ================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in every value below
# 3. NEVER commit .env.local to GitHub
# ================================================

# ── STRIPE ──────────────────────────────────────
# stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Run: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe Dashboard → Products → [Product] → Price ID
STRIPE_LIFETIME_PRICE_ID=price_REPLACE_ME
STRIPE_MONTHLY_PRICE_ID=price_REPLACE_ME

# ── ANTHROPIC ────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── RESEND (email) ───────────────────────────────
# resend.com → API Keys (free: 3k emails/month)
RESEND_API_KEY=re_REPLACE_ME

# ── APP ──────────────────────────────────────────
# Your deployed URL (use http://localhost:3000 for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Any random string — make it long
ACCESS_TOKEN_SECRET=change-this-to-something-random-and-long-32-chars

# Set to "true" while testing — shows app without real payment
DEMO_MODE=true
